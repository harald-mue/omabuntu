{
  // Omabuntu menu definition. This follows Omarchy's omarchy-menu.jsonc
  // entry schema at stable commit ac2690cd7be4f47e4a255f5e2e78d904d436b068 (MIT,
  // preserved in licenses/Omarchy-MIT.txt): IDs are object keys, dotted IDs
  // imply hierarchy, and kind is inferred (action -> action, target -> link,
  // otherwise submenu). Icons keep the original upstream glyphs. `when`,
  // `checked`, and `disabled` are bash conditions that one batched guard
  // process evaluates (see tools/menu_model.py). Actions use a reviewed
  // omabuntu registry instead of arbitrary shell commands; tools/menu_model.py
  // builds the dispatch allowlist from this file and refuses everything else.
  // Excluded upstream sections (install, remove, update, trigger, about,
  // dmenu modes, locale catalogs) are documented in plans/002-command-menu.md
  // and docs/command-menu.md. Setup keeps only reviewed default-application
  // rows backed by xdg-settings and xdg-terminal-exec.

  // Root menu (upstream order: apps, learn, appearance, trigger, setup, install,
  // remove, update, about, system; only sections with reviewed Ubuntu
  // backends are kept).
  "apps": {"icon": "\udb80\udc3b", "label": "Apps", "aliases": ["app", "applications"], "action": "omabuntu-open:apps"},
  "learn": {"icon": "\udb82\uddd1", "label": "Learn"},
  "appearance": {"icon": "\udb80\udfd8", "label": "Appearance", "aliases": ["style", "theme-menu"]},
  "trigger": {"icon": "\udb85\udcde", "label": "Trigger"},
  "setup": {"icon": "\ue615", "label": "Setup", "aliases": ["settings"]},
  "system": {"icon": "\uf011", "label": "System", "aliases": ["power-menu", "power"]},

  // Learn (adapted: Ubuntu documentation replaces the Arch wiki; the Tmux,
  // Herdr, Omarchy-manual, community and webapp rows stay excluded).
  "learn.keybindings": {"icon": "\uf11c", "label": "Keybindings", "action": "omabuntu-open:keybindings"},
  "learn.hyprland": {"icon": "\uf359", "label": "Hyprland", "description": "Open the Hyprland wiki", "action": "xdg-open:https://wiki.hypr.land/"},
  "learn.ubuntu": {"icon": "\uf08b", "label": "Ubuntu", "description": "Open the Ubuntu desktop documentation", "action": "xdg-open:https://help.ubuntu.com/"},

  "trigger.capture": {"icon": "\uf030", "label": "Capture"},
  "trigger.capture.screenshot": {"icon": "\uf030", "label": "Screenshot", "action": "omabuntu-session:screenshot"},

  // Appearance: only the reviewed theme/font/background routes. Theme and Background open the
  // image picker (upstream opens omarchy.image-picker the same way); their
  // provider fields stay because applying re-derives the row by id inside
  // tools/menu_model.py. Font stays a provider submenu in the card.
  "appearance.theme": {"icon": "\udb83\ude0c", "label": "Theme", "aliases": ["theme", "themes", "style.theme"], "provider": "themes", "action": "omabuntu-open:themes"},
  "appearance.background": {"icon": "\uf03e", "label": "Background", "aliases": ["background", "wallpaper", "style.background"], "provider": "backgrounds", "action": "omabuntu-open:backgrounds"},
  "appearance.font": {"icon": "\ue659", "label": "Font", "aliases": ["style.font"], "provider": "fonts"},

  // Original stable Appearance rows with a closed Ubuntu preference registry.
  // Bar positioning, window effects, branding and Plymouth remain excluded.
  "appearance.top-bar": {"icon":"󰍜","label":"Menu Bar","when":"appearance:available"},
  "appearance.top-bar.hide": {"icon":"󰈉","label":"Hide Bar","when":"appearance:hidden:off","action":"omabuntu-appearance:hidden:on"},
  "appearance.top-bar.show": {"icon":"󰈈","label":"Show Bar","when":"appearance:hidden:on","action":"omabuntu-appearance:hidden:off"},
  "appearance.top-bar.background": {"icon":"󰂵","label":"Bar Background"},
  "appearance.top-bar.background.opaque": {"icon":"󰝤","label":"Opaque Bar","checked":"appearance:background:opaque","action":"omabuntu-appearance:background:opaque"},
  "appearance.top-bar.background.glassy": {"icon":"󰂵","label":"Glassy Bar","checked":"appearance:background:glassy","action":"omabuntu-appearance:background:glassy","description":"Translucent bar background; compositor blur remains user-owned"},
  "appearance.top-bar.background.clear": {"icon":"󰝣","label":"Clear Bar","checked":"appearance:background:none","action":"omabuntu-appearance:background:none"},
  "appearance.top-bar.indicators": {"icon":"󰋽","label":"Bar Indicators"},
  "appearance.top-bar.indicators.battery-percentage-on": {"icon":"󰁹","label":"Show Battery %","when":"appearance:battery-show","action":"omabuntu-appearance:battery-percentage:on"},
  "appearance.top-bar.indicators.battery-percentage-off": {"icon":"󰁹","label":"Hide Battery %","when":"appearance:battery-hide","action":"omabuntu-appearance:battery-percentage:off"},
  "appearance.top-bar.indicators.clock": {"icon":"󰥔","label":"Clock"},
  "appearance.top-bar.indicators.clock.sunday-24h": {"icon":"󰥔","label":"Sunday 14:30","checked":"appearance:clock:sunday-24h","action":"omabuntu-appearance:clock:sunday-24h"},
  "appearance.top-bar.indicators.clock.sunday-12h": {"icon":"󰥔","label":"Sunday 2:30 PM","checked":"appearance:clock:sunday-12h","action":"omabuntu-appearance:clock:sunday-12h"},
  "appearance.top-bar.indicators.clock.sunday-seconds-24h": {"icon":"󰥔","label":"Sunday 14:30:05","checked":"appearance:clock:sunday-seconds-24h","action":"omabuntu-appearance:clock:sunday-seconds-24h"},
  "appearance.top-bar.indicators.clock.sunday-seconds-12h": {"icon":"󰥔","label":"Sunday 2:30:05 PM","checked":"appearance:clock:sunday-seconds-12h","action":"omabuntu-appearance:clock:sunday-seconds-12h"},
  "appearance.top-bar.indicators.clock.time-24h": {"icon":"󰥔","label":"14:30","checked":"appearance:clock:time-24h","action":"omabuntu-appearance:clock:time-24h"},
  "appearance.top-bar.indicators.clock.time-12h": {"icon":"󰥔","label":"2:30 PM","checked":"appearance:clock:time-12h","action":"omabuntu-appearance:clock:time-12h"},
  "appearance.top-bar.indicators.clock.date-24h": {"icon":"󰥔","label":"Sun 3 May 14:30","checked":"appearance:clock:date-24h","action":"omabuntu-appearance:clock:date-24h"},
  "appearance.top-bar.indicators.clock.date-12h": {"icon":"󰥔","label":"Sun 3 May 2:30 PM","checked":"appearance:clock:date-12h","action":"omabuntu-appearance:clock:date-12h"},
  "appearance.top-bar.indicators.clock.week": {"icon":"󰥔","label":"3 May W18 2026","checked":"appearance:clock:week","action":"omabuntu-appearance:clock:week"},
  "appearance.top-bar.indicators.clock.iso": {"icon":"󰥔","label":"2026-05-03 14:30","checked":"appearance:clock:iso","action":"omabuntu-appearance:clock:iso"},
  "appearance.dock": {"icon":"󱂩","label":"Dock","when":"appearance:floating"},
  "appearance.dock.autohide": {"icon":"󰈉","label":"Auto-hide Dock","when":"appearance:dock-autohide:off","action":"omabuntu-appearance:dock-autohide:on"},
  "appearance.dock.always-on": {"icon":"󰈈","label":"Always-on Dock","when":"appearance:dock-autohide:on","action":"omabuntu-appearance:dock-autohide:off"},
  "appearance.dock.position": {"icon":"","label":"Dock Position"},
  "appearance.dock.position.top": {"icon":"󰁝","label":"Top Dock","checked":"appearance:dock-position:top","action":"omabuntu-appearance:dock-position:top"},
  "appearance.dock.position.bottom": {"icon":"󰁅","label":"Bottom Dock","checked":"appearance:dock-position:bottom","action":"omabuntu-appearance:dock-position:bottom"},
  "appearance.dock.position.left": {"icon":"󰁍","label":"Left Dock","checked":"appearance:dock-position:left","action":"omabuntu-appearance:dock-position:left"},
  "appearance.dock.position.right": {"icon":"󰁔","label":"Right Dock","checked":"appearance:dock-position:right","action":"omabuntu-appearance:dock-position:right"},

  // Setup > Defaults: only installed browsers and terminals, applied through
  // xdg-settings and the xdg-terminal-exec preference list. Rows come from
  // tools/defaults_backend.py at dispatch time; nothing is installed here.
  "setup.default": {"icon": "\uf005", "label": "Defaults", "title": "Default applications"},
  "setup.default.browser": {"icon": "\uf488", "label": "Browser", "title": "Default browser", "provider": "default-browsers"},
  "setup.default.terminal": {"icon": "\uf489", "label": "Terminal", "title": "Default terminal", "provider": "default-terminals"},

  // System menu (Super+Escape opens this route). Upstream order is kept:
  // screensaver, lock, suspend, hibernate, logout, reboot, shutdown. Only
  // screensaver stays excluded. Lock uses the existing installed manager.
  // Other session-ending actions remain gated in tools/power_actions.py.
  "system.lock": {"icon": "\uf023", "label": "Lock", "action": "omabuntu-session:lock"},
  "system.suspend": {"icon": "\udb81\udcb2", "label": "Suspend", "when": "omabuntu-can-suspend", "action": "systemctl:suspend"},
  "system.hibernate": {"icon": "\udb82\udd01", "label": "Hibernate", "when": "omabuntu-can-hibernate", "action": "systemctl:hibernate"},
  "system.logout": {"icon": "\udb80\udf43", "label": "Logout", "action": "uwsm:stop"},
  "system.reboot": {"icon": "\udb81\udf09", "label": "Reboot", "action": "systemctl:reboot"},
  "system.shutdown": {"icon": "\udb81\udc25", "label": "Shutdown", "action": "systemctl:poweroff"}
}
