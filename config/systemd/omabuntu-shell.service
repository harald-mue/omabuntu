# Omabuntu shell login autostart (plan 012, Option A: pure autostart).
# Deployed to ~/.config/systemd/user/omabuntu-shell.service by
# tools/deploy_autostart.py. Enabled only after explicit user approval.
# No Restart directive: the shell starts once per login and is never a
# supervisor. The manager's running.json record stays the source of truth
# for the owned process. Active (exited) only confirms launcher completion.
# RemainAfterExit keeps the shell's control group alive after the manager
# exits; stopping this unit terminates that group, including at logout.
# Use `omabuntu stop` for an identity-checked manual shell stop.
# ExecStartPre only waits until the live instance lock is listed. It is not
# a shell lifetime and it does not restart a shell that exits later.
[Unit]
Description=Omabuntu shell login autostart hand-off
PartOf=graphical-session.target
Requires=graphical-session.target
After=graphical-session.target
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=/usr/bin/python3 %h/.config/systemd/user/omabuntu-shell-wait.py
ExecStart=%h/.local/bin/omabuntu start
Slice=session.slice

[Install]
WantedBy=graphical-session.target
